# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# Marca activa: nombre de una carpeta dentro de marcas/ (sin valor = plantilla)
MARCA=tecnocare

# Supabase (Project Settings → API). Son públicos: van en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (Project Settings → API → service_role). MUY privada: solo el servidor, para gestionar el equipo.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio). Privada: solo la usa el servidor.
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-3.8-flash, respaldo gemini-3.6-flash)
# GEMINI_MODEL=

# Granola (Settings → Connectors → Personal API keys). Privada: solo la usa el servidor.
GRANOLA_API_KEY=

# Ozonar: Google Maps (Places API New) y Tavily. Privadas: solo las usa el servidor.
GOOGLE_PLACES_API_KEY=
TAVILY_API_KEY=

# Servidor
PORT=3000
